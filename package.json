{
  "name": "@farutech/design-system",
  "version": "2026.01.31.0-alpha.0",
  "description": "Farutech Design System - UI Components & Hooks",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "farutech-sdk": "./bin/farutech-sdk-cli.js"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "version:alpha": "node scripts/version-alpha.js",
    "version:beta": "node scripts/version-beta.js",
    "version:rc": "node scripts/version-rc.js",
    "version:release": "node scripts/version-release.js",
    "publish:dev": "npm publish --tag dev",
    "publish:qa": "npm publish --tag qa",
    "publish:staging": "npm publish --tag staging",
    "publish:prod": "npm publish --tag latest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "commander": "^12.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.563.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^1.0.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
